# https://editorconfig.org —— 让不同编辑器落到同一套格式上
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false   # 中文文档里行尾两个空格表示换行，别被编辑器吃掉
indent_size = 2

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
